# Template .env untuk server produksi VPS.
#
# Cara pakai di VPS:
#   cp deploy/env.production.example .env
#   nano .env          # isi nilai yang masih kosong/placeholder di bawah
#   php artisan key:generate   # generate APP_KEY baru khusus produksi (jangan pakai punya lokal)
#
# JANGAN pernah commit file .env yang sudah terisi ke git.

APP_NAME="E-Tiket RS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etiket
DB_USERNAME=etiket_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Wajib "database" di produksi (bukan "sync") + queue worker via Supervisor,
# supaya notifikasi WhatsApp (tiket baru & selesai) tidak memblokir request.
# Lihat deploy/supervisor/etiket-worker.conf.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
